# Exemple de Secret pour Nominatim. À copier en secrets.yaml et remplir
# avec une vraie valeur, NE PAS commit les secrets réels.
#
# Le password Postgres est utilisé en interne par mediagis/nominatim — il n'a
# pas besoin d'être robuste tant que Postgres n'est pas exposé hors du cluster
# (ce qui est le cas en V1).
apiVersion: v1
kind: Secret
metadata:
  name: nominatim-backend
  namespace: dev
type: Opaque
stringData:
  NOMINATIM_PASSWORD: "change-me-before-deploy"
