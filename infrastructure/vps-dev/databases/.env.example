################################################################################
# Variables d'environnement — Bases de données VPS-dev
# TissiMah
#
# IMPORTANT:
# 1. Copiez ce fichier vers .env
# 2. Remplacez les valeurs par vos propres secrets
# 3. NE COMMITEZ JAMAIS le fichier .env dans Git !
#
# Commandes :
#   cp .env.example .env
#   nano .env
################################################################################

#------------------------------------------------------------------------------
# AUTH SERVICE — PostgreSQL
#------------------------------------------------------------------------------

# Utilisateur PostgreSQL
AUTH_POSTGRES_USER=auth_user

# Mot de passe PostgreSQL
# Génération : openssl rand -base64 32
AUTH_POSTGRES_PASSWORD=

# Nom de la base de données
AUTH_POSTGRES_DB=auth_db

# Host (utilisé dans le healthcheck)
AUTH_POSTGRES_HOST=localhost

# Port exposé
AUTH_POSTGRES_PORT=5432

# Méthode d'authentification
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

#------------------------------------------------------------------------------
# AUTH SERVICE — Redis
#------------------------------------------------------------------------------

# Port Redis auth-service
AUTH_REDIS_PORT=6379

# Mot de passe Redis
# Génération : openssl rand -base64 32
AUTH_REDIS_PASSWORD=
