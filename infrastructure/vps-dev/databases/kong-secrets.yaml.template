################################################################################
# Kong Secrets Template
# TissiMah VPS-dev
#
# Ce fichier est un TEMPLATE. Il sera rempli avec les vraies valeurs
# depuis le fichier .env par le script kong-install.sh
#
# ⚠️ NE JAMAIS COMMITER ce fichier avec les vraies valeurs dans Git !
################################################################################

---
# Secret pour Redis Kong (rate-limiting)
apiVersion: v1
kind: Secret
metadata:
  name: kong-redis-secret
  namespace: default
  labels:
    app.kubernetes.io/name: kong
    app.kubernetes.io/component: secret
    app.kubernetes.io/managed-by: helm
type: Opaque
stringData:
  # Mot de passe Redis Kong
  password: "__KONG_REDIS_PASSWORD__"

  # Host Redis Kong (127.0.0.1 car network_mode: host)
  host: "__KONG_REDIS_HOST__"

  # Port Redis Kong
  port: "__KONG_REDIS_PORT__"

  # Database Redis (1 pour Kong)
  database: "1"

---
# Secret pour Firebase (JWT validation)
apiVersion: v1
kind: Secret
metadata:
  name: kong-firebase-secret
  namespace: default
  labels:
    app.kubernetes.io/name: kong
    app.kubernetes.io/component: secret
    app.kubernetes.io/managed-by: helm
type: Opaque
stringData:
  # Firebase Project ID (public, mais on le met ici pour centraliser)
  projectId: "tissi-mah-dev"

  # Firebase API Key (public aussi, utilisé par les clients)
  apiKey: "__FIREBASE_API_KEY__"

  # Note: Firebase Admin SDK Service Account Key sera ajoutée plus tard
  # quand tu en auras besoin pour la validation côté serveur

---
# Secret pour les domaines CORS (environnement VPS-dev)
apiVersion: v1
kind: Secret
metadata:
  name: kong-cors-secret
  namespace: default
  labels:
    app.kubernetes.io/name: kong
    app.kubernetes.io/component: secret
    app.kubernetes.io/managed-by: helm
type: Opaque
stringData:
  # Origines autorisées pour CORS (séparées par des virgules)
  # Format: "https://domain1.com,https://domain2.com,http://localhost:3000"
  origins: "https://api.tissimah.kpeewu.dev,https://dev-admin.tissi-mah.com,http://localhost:3000,http://localhost:8080"

---
# ConfigMap pour les configurations non-sensibles
apiVersion: v1
kind: ConfigMap
metadata:
  name: kong-config
  namespace: default
  labels:
    app.kubernetes.io/name: kong
    app.kubernetes.io/component: config
    app.kubernetes.io/managed-by: helm
data:
  # Environnement
  ENVIRONMENT: "vps-dev"

  # Log level
  LOG_LEVEL: "debug"

  # Host Kong
  KONG_HOST: "api.tissimah.kpeewu.com"

  # Services endpoints
  AUTH_SERVICE_HOST: "auth-service.default.svc.cluster.local"
  AUTH_SERVICE_PORT: "50051"

  # Rate limiting (valeurs non-sensibles)
  RATE_LIMIT_GLOBAL_MINUTE: "120"
  RATE_LIMIT_GLOBAL_HOUR: "5000"
  RATE_LIMIT_AUTH_SECOND: "5"
  RATE_LIMIT_AUTH_MINUTE: "30"
  RATE_LIMIT_CREATE_ACCOUNT_MINUTE: "10"
  RATE_LIMIT_SENSITIVE_MINUTE: "5"

---
# Notes d'utilisation
# ================
#
# Créer les secrets:
#   kubectl apply -f kong-secrets.yaml
#
# Vérifier les secrets:
#   kubectl get secrets | grep kong
#   kubectl describe secret kong-redis-secret
#
# Voir le contenu d'un secret (base64 décodé):
#   kubectl get secret kong-redis-secret -o jsonpath='{.data.password}' | base64 -d
#
# Supprimer tous les secrets Kong:
#   kubectl delete secret kong-redis-secret kong-firebase-secret kong-cors-secret
#   kubectl delete configmap kong-config
#
# Mettre à jour un secret:
#   kubectl delete secret kong-redis-secret
#   kubectl apply -f kong-secrets.yaml
#
# ⚠️ SÉCURITÉ:
# Ce fichier ne doit JAMAIS être commité dans Git avec les vraies valeurs !
# Utilisez le script kong-install.sh qui remplace les placeholders depuis .env
