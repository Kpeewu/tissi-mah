# =============================================================================
# TissiMah — Variables d'environnement (docker-compose)
# =============================================================================
# cp .env.example .env

# ============================================
# ENVIRONMENT & LOGGING
# ============================================
ENVIRONMENT=local
# Options: local, vps-dev, staging, prod
LOG_LEVEL=debug
# Options: debug, info, warn, error

# ============================================
# FIREBASE
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
# Télécharger depuis Firebase Console > Project Settings > Service Accounts

# ============================================
# Auth Service (PostgreSQL — port 5433)
# ============================================
POSTGRES_AUTH_USER=dev
POSTGRES_AUTH_PASSWORD=dev123
POSTGRES_AUTH_DB=auth_db

# ============================================
# User Service (MongoDB — port 27018)
# ============================================
MONGO_USER_USER=dev
MONGO_USER_PASSWORD=dev123
MONGO_USER_DB=user_db

# ============================================
# File Service (PostgreSQL — port 5434)
# ============================================
POSTGRES_FILE_USER=dev
POSTGRES_FILE_PASSWORD=dev123
POSTGRES_FILE_DB=file_db

# ============================================
# Rating Service (PostgreSQL — port 5435)
# ============================================
POSTGRES_RATING_USER=dev
POSTGRES_RATING_PASSWORD=dev123
POSTGRES_RATING_DB=rating_db

# ============================================
# Vehicle Service (PostgreSQL — port 5436)
# ============================================
POSTGRES_VEHICLE_USER=dev
POSTGRES_VEHICLE_PASSWORD=dev123
POSTGRES_VEHICLE_DB=vehicle_db

# ============================================
# Trips Service (PostGIS — port 5437)
# ============================================
POSTGRES_TRIPS_USER=dev
POSTGRES_TRIPS_PASSWORD=dev123
POSTGRES_TRIPS_DB=trips_db

# ============================================
# Booking Service (PostgreSQL — port 5438)
# ============================================
POSTGRES_BOOKING_USER=dev
POSTGRES_BOOKING_PASSWORD=dev123
POSTGRES_BOOKING_DB=booking_db
