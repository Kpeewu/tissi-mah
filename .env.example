# .env.example
# Copier ce fichier en .env et ajuster les valeurs si nécessaire
#
# Usage: cp .env.example .env

# ============================================
# DATABASES - Auth Service (PostgreSQL)
# ============================================
POSTGRES_AUTH_USER=dev
POSTGRES_AUTH_PASSWORD=dev123
POSTGRES_AUTH_DB=auth_db

# ============================================
# DATABASES - User Service (MongoDB)
# ============================================
MONGO_USER_USER=dev
MONGO_USER_PASSWORD=dev123
MONGO_USER_DB=user_db

# ============================================
# DATABASES - Rating Service (PostgreSQL)
# ============================================
POSTGRES_RATING_USER=dev
POSTGRES_RATING_PASSWORD=dev123
POSTGRES_RATING_DB=rating_db

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=local
# Options: local, vps-dev, staging, prod

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
# Options: debug, info, warn, error

# ============================================
# FIREBASE
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
# Télécharger depuis Firebase Console > Project Settings > Service Accounts
