# .env.example
# Copier ce fichier en .env et ajuster les valeurs si nécessaire
# 
# Usage: cp .env.example .env

# ============================================
# DATABASES - Auth Service (PostgreSQL)
# ============================================
POSTGRES_AUTH_USER=dev
POSTGRES_AUTH_PASSWORD=dev123
POSTGRES_AUTH_DB=auth_db

# ============================================
# CACHE - Redis (partagé par tous les services)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Laisser vide pour pas de password en dev

# ============================================
# SERVICE PORTS
# ============================================
AUTH_SERVICE_PORT=50051


# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
# Options: debug, info, warn, error

# ============================================
# FIREBASE (Auth Service)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./config/firebase-credentials.json
# Télécharger depuis Firebase Console > Project Settings > Service Accounts

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=local
# Options: local, vps-dev, staging, prod