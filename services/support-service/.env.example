# Database
DATABASE_URL=postgresql://dev:dev123@localhost:5441/support_db?sslmode=disable
REDIS_URL=redis://localhost:6390/0

# Runtime
ENVIRONMENT=local
LOG_LEVEL=debug
GRPC_PORT=50063

# Email service (pour OTP + mot de passe provisoire)
EMAIL_SERVICE_HOST=0.0.0.0
EMAIL_SERVICE_PORT=50061

# Auth (DOIT matcher SUPPORT_JWT_SECRET côté api-gateway)
JWT_SECRET=change-me-dev-secret-min-32-bytes-long!!
JWT_TTL_HOURS=12
REFRESH_TOKEN_TTL_HOURS=720

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=300

# Rate limiting (login + OTP failures)
LOGIN_FAIL_THRESHOLD=5
LOGIN_FAIL_WINDOW_SECONDS=86400
