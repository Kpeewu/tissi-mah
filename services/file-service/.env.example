# =============================================================================
# File Service - Variables d'environnement
# =============================================================================

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
DATABASE_URL=postgresql://dev:dev123@localhost:5434/file_db?sslmode=disable
REDIS_URL=redis://localhost:6383/0

# --- S3 / MinIO ---
S3_BUCKET=tissi-mah-files
S3_REGION=us-east-1
# Compte de service dédié (voir minio-init dans docker-compose.yml)
S3_ACCESS_KEY=filesvc
S3_SECRET_KEY=filesvc-dev-secret
# Endpoint interne (connexion file-service → MinIO)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Endpoint public pour les URL présignées envoyées aux clients (HTTPS en staging/prod)
# Laisser vide en dev local (utilise S3_ENDPOINT)
# Ex: S3_PUBLIC_ENDPOINT=https://storage.tissimah.kpeewu.dev
S3_PUBLIC_ENDPOINT=

# --- Optionnel ---
# GRPC_PORT=50053
# GRPC_ADDRESS=0.0.0.0
