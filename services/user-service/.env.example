# =============================================================================
# User Service — Variables d'environnement
# =============================================================================
# cp .env.example .env

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
MONGODB_URL=mongodb://dev:dev123@localhost:27018/user_db?authSource=admin
MONGODB_DATABASE=user_db
REDIS_URL=redis://localhost:6382/0

# --- Auth Service (inter-service) ---
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=50051

# --- File Service (inter-service) ---
FILE_SERVICE_HOST=0.0.0.0
FILE_SERVICE_PORT=50053

# --- Optionnel ---
# GRPC_PORT=50052
# GRPC_ADDRESS=0.0.0.0
