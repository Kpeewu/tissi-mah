# =============================================================================
# Payment Service - Variables d'environnement
# =============================================================================
# cp .env.example .env

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
DATABASE_URL=postgresql://dev:dev123@localhost:5439/payment_db?sslmode=disable
REDIS_URL=redis://localhost:6388/0

# --- FedaPay Sandbox (utilisé quand ENVIRONMENT=local ou vps-dev) ---
FEDAPAY_SANDBOX_API_URL=https://sandbox-api.fedapay.com
FEDAPAY_SANDBOX_API_KEY=sk_sandbox_xxxxx
FEDAPAY_SANDBOX_WEBHOOK_SECRET=whsec_sandbox_xxxxx

# --- FedaPay Live (utilisé quand ENVIRONMENT=staging ou prod) ---
FEDAPAY_LIVE_API_URL=https://api.fedapay.com
FEDAPAY_LIVE_API_KEY=sk_live_xxxxx
FEDAPAY_LIVE_WEBHOOK_SECRET=whsec_live_xxxxx

# --- Paiement FedaPay avec redirection ---
# URL de retour après paiement sur la page FedaPay (handler public de l'api-gateway,
# qui redirige ensuite vers le deep link mobile). Obligatoire hors ENVIRONMENT=local.
# En local, exposer l'api-gateway via un tunnel (ngrok…) pour tester le retour.
PAYMENT_CALLBACK_URL=http://localhost:8080/api/v1/payment/callback

# --- Booking Service (inter-service) ---
BOOKING_SERVICE_HOST=0.0.0.0
BOOKING_SERVICE_PORT=50058

# --- User Service (inter-service) ---
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052

# --- Optionnel ---
# GRPC_PORT=50059
# GRPC_ADDRESS=0.0.0.0
# PAYOUT_INTERVAL_SECONDS=1800
# CONTESTATION_DELAY_HOURS=2
# PLATFORM_FEE_PERCENT=10
# CANCELLATION_FULL_REFUND_HOURS=24
# CANCELLATION_GRACE_PERIOD_MINUTES=30
# NOSHOW_DRIVER_DELAY_MINUTES=15
# NOSHOW_PASSENGER_DELAY_MINUTES=15
# EXPIRATION_INTERVAL_SECONDS=60
# Fenêtre de paiement (depuis la création de la réservation) avant suppression FedaPay + libération des places
# PAYMENT_TIMEOUT_MINUTES=10

# --- Fenêtre horaire des batches automatiques (PayoutWorker chauffeurs +
# RefundWorker passagers). En dehors de cette fenêtre, les workers ticker
# mais ne déclenchent aucun batch. ExpirationWorker, webhooks FedaPay et
# TriggerManualPayout (admin) restent 24/7 indépendamment.
# Mettre PAYMENT_WINDOW_ENABLED=false pour désactiver le fenêtrage (dev). ---
# PAYMENT_WINDOW_ENABLED=true
# PAYMENT_WINDOW_TIMEZONE=Africa/Lome
# PAYMENT_WINDOW_START_HOUR=0
# PAYMENT_WINDOW_END_HOUR=3
