# =============================================================================
# Booking Service - Variables d'environnement
# =============================================================================
# cp .env.example .env

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
DATABASE_URL=postgresql://dev:dev123@localhost:5438/booking_db?sslmode=disable
REDIS_URL=redis://localhost:6387/0

# --- Trips Service (inter-service) ---
TRIPS_SERVICE_HOST=0.0.0.0
TRIPS_SERVICE_PORT=50056

# --- User Service (inter-service) ---
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052

# --- Optionnel ---
# GRPC_PORT=50058
# GRPC_ADDRESS=0.0.0.0
# SERVICE_FEE_PERCENT=10
# RECONCILIATION_INTERVAL_SECONDS=300
# Sweeper des réservations paymentPending : au-delà de ce délai (≥ PAYMENT_TIMEOUT_MINUTES de
# payment-service + marge), une réservation sans paiement abouti est passée en paymentFailed
# et ses places sont libérées.
# PAYMENT_PENDING_TIMEOUT_MINUTES=12
# PAYMENT_PENDING_SWEEPER_INTERVAL_SECONDS=60
# Rejeu des demandes de remboursement non acquittées par payment-service (annulation, rejet, no-show
# d'une réservation payée en ligne) : tick du worker.
# REFUND_REQUEST_WORKER_INTERVAL_SECONDS=60
