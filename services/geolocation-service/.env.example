# =============================================================================
# Geolocation Service — Variables d'environnement
# =============================================================================
# cp .env.example .env

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug

# --- Backends self-hosted ---
# OSRM est obligatoire — le service refuse de démarrer sans.
OSRM_URL=http://localhost:5000

# Nominatim est optionnel — si vide, Geocode/ReverseGeocode renvoient
# ErrorGeocodingUnavailable (utile pour développer ComputeRoute en isolation).
NOMINATIM_URL=http://localhost:8080

# --- Cache Redis ---
# Si Redis est injoignable au démarrage, le service tourne en graceful
# degradation (sans cache, latence dégradée mais pas d'erreur).
REDIS_URL=redis://localhost:6385/0

# --- Filtre par défaut Geocode ---
# ISO codes séparés par virgules. Appliqué quand Geocode.CountryFilter
# est vide dans la requête.
GEOCODE_DEFAULT_COUNTRIES=tg,gh,bj,bf

# --- Serveur gRPC ---
# GRPC_PORT=50064
# GRPC_ADDRESS=0.0.0.0
