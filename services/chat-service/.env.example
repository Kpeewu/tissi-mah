# =============================================================================
# Chat Service - Variables d'environnement
# =============================================================================
# cp .env.example .env
# Pour générer CHAT_ENCRYPTION_KEY:
#   openssl rand -base64 32

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
DATABASE_URL=postgresql://dev:dev123@localhost:5442/chat_db?sslmode=disable
REDIS_URL=redis://localhost:6392/0

# Bus inter-services (publication NEW_MESSAGE consommée par notification-service).
# Pointe vers le même Redis que les autres services qui publient des events.
NOTIFICATION_REDIS_URL=redis://localhost:6386/0

# Clé de chiffrement AES-256-GCM (base64, 32 bytes aléatoires).
# DOIT être identique sur tous les pods. Rotation = re-chiffrement complet.
CHAT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64

# --- Services inter-service ---
BOOKING_SERVICE_HOST=0.0.0.0
BOOKING_SERVICE_PORT=50058
TRIPS_SERVICE_HOST=0.0.0.0
TRIPS_SERVICE_PORT=50055
SUPPORT_SERVICE_HOST=0.0.0.0
SUPPORT_SERVICE_PORT=50063

# --- Optionnel ---
# GRPC_PORT=50065
# GRPC_ADDRESS=0.0.0.0
# TRIP_CLOSER_INTERVAL_SECONDS=30
# MESSAGE_RETENTION_DAYS=180
