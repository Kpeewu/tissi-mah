# =============================================================================
# API Gateway — Variables d'environnement
# =============================================================================

# Serveur HTTP
HTTP_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Environnement : local / vps-dev / staging / prod
ENVIRONMENT=local

# Redis (rate limiting)
REDIS_URL=redis://localhost:6381/0

# Firebase (validation JWT)
FIREBASE_PROJECT_ID=tissi-mah-dev

# Services internes (gRPC)
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=50051
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052

# CORS (origines séparées par des virgules, * pour tout autoriser)
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=debug

# Rate limiting (optionnel — valeurs par défaut si non défini)
# RATE_LIMIT_GLOBAL_MINUTE=60
# RATE_LIMIT_GLOBAL_HOUR=1000
# RATE_LIMIT_AUTH_SECOND=1
# RATE_LIMIT_AUTH_MINUTE=10
# RATE_LIMIT_AUTH_HOUR=100
# RATE_LIMIT_CREATE_MINUTE=3
# RATE_LIMIT_CREATE_HOUR=10
# RATE_LIMIT_SENSITIVE_MINUTE=1
# RATE_LIMIT_SENSITIVE_HOUR=5
