# =============================================================================
# API Gateway — Variables d'environnement
# =============================================================================
# cp .env.example .env

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
REDIS_URL=redis://localhost:6380/0
FIREBASE_PROJECT_ID=tissi-mah-dev

# --- Serveur HTTP ---
# HTTP_PORT=8080
# HTTP_ADDRESS=0.0.0.0

# --- Services internes (gRPC) ---
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=50051
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052
FILE_SERVICE_HOST=0.0.0.0
FILE_SERVICE_PORT=50053
RATING_SERVICE_HOST=0.0.0.0
RATING_SERVICE_PORT=50054
VEHICLE_SERVICE_HOST=0.0.0.0
VEHICLE_SERVICE_PORT=50055
TRIPS_SERVICE_HOST=0.0.0.0
TRIPS_SERVICE_PORT=50056
KYC_SERVICE_HOST=0.0.0.0
KYC_SERVICE_PORT=50057
BOOKING_SERVICE_HOST=0.0.0.0
BOOKING_SERVICE_PORT=50058
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=50059
NOTIF_SERVICE_HOST=0.0.0.0
NOTIF_SERVICE_PORT=50060
SUPPORT_SERVICE_HOST=0.0.0.0
SUPPORT_SERVICE_PORT=50063
GEOLOCATION_SERVICE_HOST=0.0.0.0
GEOLOCATION_SERVICE_PORT=50064
CHAT_SERVICE_HOST=0.0.0.0
CHAT_SERVICE_PORT=50065

# --- Support JWT (back-office) ---
# Doit matcher JWT_SECRET de support-service (min 32 bytes)
SUPPORT_JWT_SECRET=change-me-dev-secret-min-32-bytes-long!!

# --- App ID whitelist ---
# UUIDs bundlés dans les builds clients. CSV pour la rotation sans downtime.
# Générer avec : uuidgen
MOBILE_APP_IDS=00000000-0000-0000-0000-000000000001
SUPPORT_APP_IDS=00000000-0000-0000-0000-000000000002

# --- Signature inter-services (optionnel en local) ---
# Génère avec : openssl rand -hex 32
# Doit être identique à INTERNAL_HMAC_SECRET de tous les services en vps-dev/prod.
# INTERNAL_HMAC_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- Rate limiting (optionnel — valeurs par défaut si non défini) ---
# RATE_LIMIT_GLOBAL_MINUTE=60
# RATE_LIMIT_GLOBAL_HOUR=1000
# RATE_LIMIT_AUTH_SECOND=1
# RATE_LIMIT_AUTH_MINUTE=10
# RATE_LIMIT_AUTH_HOUR=100
# RATE_LIMIT_CREATE_MINUTE=3
# RATE_LIMIT_CREATE_HOUR=10
# RATE_LIMIT_SENSITIVE_MINUTE=1
# RATE_LIMIT_SENSITIVE_HOUR=5
