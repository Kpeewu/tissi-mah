# =============================================================================
# KYC Service — Variables d'environnement
# =============================================================================
# cp .env.example .env
#
# La validation KYC est 100 % manuelle (support) : aucune variable de fournisseur
# d'identité externe.

# --- Obligatoire ---
ENVIRONMENT=local
LOG_LEVEL=debug
NOTIFICATION_REDIS_URL=redis://localhost:6389/0

# --- Services inter-service ---
FILE_SERVICE_HOST=0.0.0.0
FILE_SERVICE_PORT=50053
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052
SUPPORT_SERVICE_HOST=0.0.0.0
SUPPORT_SERVICE_PORT=50063
VEHICLE_SERVICE_HOST=0.0.0.0
VEHICLE_SERVICE_PORT=50055

# --- Optionnel ---
GRPC_PORT=50057
# GRPC_ADDRESS=0.0.0.0
# INTERNAL_HMAC_SECRET=
