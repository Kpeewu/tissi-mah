# Database
DATABASE_URL=postgresql://dev:dev123@localhost:5443/moderation_db?sslmode=disable

# Runtime
ENVIRONMENT=local
LOG_LEVEL=debug
GRPC_PORT=50066

# Services inter-service
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=50052
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=50051

# Fournisseurs externes (optionnels — graceful degradation si vides)
OPENAI_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Seuils de décision (texte)
TEXT_BLOCKED_THRESHOLD=0.90
TEXT_FLAGGED_THRESHOLD=0.70

# Comportement si provider externe indisponible (true = rejeter, false = laisser passer)
MODERATION_FAIL_CLOSED=false
