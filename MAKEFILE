.PHONY: proto proto-auth proto-sync test test-all lint fmt
.PHONY: install-deps update-deps sync-deps
.PHONY: workspace-init workspace-sync workspace-tidy
.PHONY: migrate migrate-status migrate-down db-backup db-restore

# Aide
help:
	@echo "$(GREEN)Tissi-Mah - Commandes disponibles$(NC)"
	@echo ""
	@echo "$(YELLOW)🗄️  Bases de données :$(NC)"
	@echo "  make deps-up         - Démarrer toutes les bases de données"
	@echo "  make deps-down       - Arrêter toutes les bases de données"
	@echo "  make deps-logs       - Voir les logs des bases de données"
	@echo "  make deps-clean      - Supprimer les volumes (⚠️  supprime les données)"
	@echo ""
	@echo "$(YELLOW)🚀 Services :$(NC)"
	@echo "  make run-auth        - Lancer auth-service (avec deps)"
	@echo "  make run-user        - Lancer user-service (avec deps)"
	@echo "  make run-client      - Lancer client-service (avec deps)"
	@echo ""
	@echo "$(YELLOW)🔧 Développement :$(NC)"
	@echo "  make proto           - Générer tous les fichiers proto"
	@echo "  make proto-auth      - Générer proto pour auth-service"
	@echo "  make proto-sync      - Synchroniser protos vers Helm charts"
	@echo "  make test            - Lancer les tests du service modifié"
	@echo "  make test-all        - Lancer tous les tests"
	@echo "  make lint            - Linter tous les services"
	@echo "  make fmt             - Formater le code"
	@echo ""
	@echo "$(YELLOW)📦 Dépendances :$(NC)"
	@echo "  make install-deps SERVICE=auth-service"
	@echo "  make update-deps SERVICE=auth-service MODE=patch"
	@echo "  make sync-deps               - Synchroniser toutes les dépendances"
	@echo ""
	@echo "$(YELLOW)🔄 Workspace Go :$(NC)"
	@echo "  make workspace-init          - Initialiser le workspace"
	@echo "  make workspace-sync          - Synchroniser le workspace"
	@echo "  make workspace-tidy          - Nettoyer tous les modules"
	@echo ""
	@echo "$(YELLOW)🗃️  Migrations :$(NC)"
	@echo "  make migrate                 - Exécuter les migrations (UP)"
	@echo "  make migrate SERVICE=auth-service"
	@echo "  make migrate-status          - Voir le statut des migrations"
	@echo "  make migrate-down            - Rollback migrations"
	@echo "  make db-backup               - Sauvegarder les bases de données"
	@echo "  make db-restore              - Restaurer les bases de données"

# === BASES DE DONNÉES (Docker) ===

deps-up:
	@echo "🚀 Démarrage des bases de données..."
	@docker-compose up -d
	@echo "✅ Bases de données démarrées :"
	@echo "   - Auth PostgreSQL   : localhost:5432"
	# @echo "   - Client PostgreSQL : localhost:5433"  # TODO: Activer quand client-service sera implémenté
	# @echo "   - User MongoDB      : localhost:27017"  # TODO: Activer quand user-service sera implémenté
	@echo "   - Redis             : localhost:6379"

deps-down:
	@echo "🛑 Arrêt des bases de données..."
	@docker-compose down
	@echo "✅ Bases de données arrêtées"

deps-logs:
	@docker-compose logs -f

deps-clean:
	@echo "⚠️  Suppression des volumes de données..."
	@docker-compose down -v
	@echo "✅ Volumes supprimés"

# === SERVICES ===

run-auth: deps-up
	@echo "🚀 Démarrage auth-service..."
	@cd services/auth-service && $(MAKE) run

run-user: deps-up
	@echo "🚀 Démarrage user-service..."
	@cd services/user-service && $(MAKE) run

run-client: deps-up
	@echo "🚀 Démarrage client-service..."
	@cd services/client-service && $(MAKE) run

# === PROTOBUF ===

proto:
	@echo "🔧 Génération de tous les fichiers proto..."
	@./scripts/development/generate-all-protos.sh
	@echo "✅ Fichiers proto générés"

proto-auth:
	@echo "🔧 Génération proto auth-service..."
	@cd services/auth-service && $(MAKE) proto

proto-sync:
	@echo "🔄 Synchronisation des protos vers Helm charts..."
	@./scripts/utilities/sync-protos-to-helm.sh
	@echo "✅ Protos synchronisés"

# === TESTS ===

test-all:
	@echo "🧪 Lancement de tous les tests..."
	@./scripts/development/run-all-tests.sh

test:
	@echo "🧪 Lancement des tests..."
	@go test ./services/... -v

# === QUALITÉ DE CODE ===

lint:
	@echo "🔍 Linting..."
	@golangci-lint run ./services/... -v

fmt:
	@echo "🎨 Formatage du code..."
	@gofmt -s -w services/
	@goimports -w -local github.com/Kpeewu/tissi-mah services/

# === DÉPENDANCES ===

install-deps:
	@./scripts/utilities/install-dependencies.sh $(SERVICE)

update-deps:
	@./scripts/utilities/update-dependencies.sh $(SERVICE) $(MODE)

sync-deps:
	@./scripts/utilities/sync-dependencies.sh

# === WORKSPACE GO ===

workspace-init:
	@echo "🔧 Initialisation du workspace Go..."
	@if [ ! -f go.work ]; then \
		go work init ./pkg ./services/auth-service; \
		echo "✅ Workspace initialisé"; \
	else \
		echo "⚠️  go.work existe déjà"; \
	fi

workspace-sync:
	@echo "🔄 Synchronisation du workspace..."
	@go work sync
	@echo "✅ Workspace synchronisé"

workspace-tidy:
	@echo "🧹 Nettoyage de tous les modules..."
	@cd pkg && go mod tidy
	@for service in services/*/; do \
		if [ -f "$$service/go.mod" ]; then \
			echo "  → Nettoyage de $$(basename $$service)"; \
			cd "$$service" && go mod tidy && cd ../..; \
		fi \
	done
	@go work sync
	@echo "✅ Tous les modules nettoyés"

# === MIGRATIONS ===

migrate:
ifdef SERVICE
	@./scripts/database/migrate-all-services.sh $(SERVICE) up
else
	@./scripts/database/migrate-all-services.sh
endif

migrate-status:
ifdef SERVICE
	@./scripts/database/migrate-all-services.sh -s $(SERVICE)
else
	@./scripts/database/migrate-all-services.sh -s
endif

migrate-down:
ifdef SERVICE
	@./scripts/database/migrate-all-services.sh -f $(SERVICE) down
else
	@./scripts/database/migrate-all-services.sh -f down
endif

db-backup:
	@./scripts/database/backup-databases.sh

db-restore:
	@./scripts/database/restore-databases.sh

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color